# =============================================
# Expensum — Environment Variables
#
# HOW TO USE LOCALLY:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in the values below
#   3. Export before running the backend:
#      source .env  (Mac/Linux)
#      OR configure these in your IDE run configuration
#   4. NEVER commit .env — it is already in .gitignore
#
# ON KOYEB / CLOUD:
#   Set each variable in the platform's environment dashboard.
# =============================================

# -----------------------------------------------
# Spring profile — set to "prod" on cloud
# -----------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# -----------------------------------------------
# Server port — Koyeb injects PORT automatically.
# Leave unset locally (defaults to 8080).
# -----------------------------------------------
# PORT=8080

# -----------------------------------------------
# Database
# Local example:  jdbc:postgresql://localhost:5433/expensum
# Cloud example:  jdbc:postgresql://<host>:<port>/<db>?sslmode=require
# -----------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/expensum
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# -----------------------------------------------
# JWT signing secret
# REQUIRED — no fallback. App will not start without this.
# Generate a strong secret:
#   openssl rand -base64 64
# Must be at least 32 characters (256 bits).
# -----------------------------------------------
JWT_SECRET=Dx+oddz3s/G+FTMAvMrwUUEUDkEQz/8HiCnsgBJ5E1TGFfWqTd81IivETkgiCaFitq88bXOVuhmqyhHO7p+Ehg==

# -----------------------------------------------
# CORS — allowed frontend origins
# Local:  http://localhost:5173
# Cloud:  https://your-frontend-domain.com
# Multiple origins comma-separated (no spaces):
#   https://expensum.app,https://www.expensum.app
# -----------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
