# =============================================
# Budget Buddy — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================

# Database password (must be strong in production)
DB_PASSWORD=your-secure-database-password-here

# JWT signing secret (must be at least 64 characters, cryptographically random)
# Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-a-cryptographically-random-string-at-least-64-characters-long

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=https://your-production-domain.com

# Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=prod
