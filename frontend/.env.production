# ===========================================
# Expensum — Frontend Production Environment
# ===========================================

# Set VITE_API_BASE_URL in your Vercel environment variables dashboard.
# This file is a reference — the real value MUST be set in Vercel,
# which overrides this file at build time.
#
# Format: https://<your-backend>.koyeb.app/api
# Vercel docs: https://vercel.com/docs/projects/environment-variables
VITE_API_BASE_URL=https://your-backend-on-koyeb.koyeb.app/api
